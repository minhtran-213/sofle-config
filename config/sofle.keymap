#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "default";

            // macOS-oriented base layer: Ctrl-Option-Cmd sit next to Space/Enter
            // (mirrors the physical Mac keyboard order), Tab/Capslock restored to
            // standard position, Backspace moved to top-right corner.
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BKSPC |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   _   |
            // | CAPS  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |        |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | LOWER | CTRL | ALT  | GUI  |  SPACE |  | ENTER | GUI  | ALT   | CTRL  | RAISE|

            bindings = <
&kp ESC         &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                          &kp N6     &kp N7         &kp N8      &kp N9   &kp N0    &kp BACKSPACE
&kp TAB         &kp Q   &kp W   &kp E   &kp R   &kp T                           &kp Y      &kp U          &kp I       &kp O    &kp P     &kp UNDERSCORE
&kp CAPSLOCK    &kp A   &kp S   &kp D   &kp F   &kp G                           &kp H      &kp J          &kp K       &kp L    &kp SEMI  &kp SQT
&kp LEFT_SHIFT  &kp Z   &kp X   &kp C   &kp V   &kp B      &kp C_MUTE  &none    &kp N      &kp M          &kp COMMA   &kp DOT  &kp FSLH  &kp RSHFT
                        &mo LOWER  &kp LCTRL  &kp LALT  &kp LEFT_GUI  &kp SPACE     &kp ENTER  &kp RIGHT_GUI  &kp RALT  &kp RCTRL  &mo RAISE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            label = "lower";

            // Symbols, F-keys, and Vim-style arrows (H/J/K/L = Left/Down/Up/Right).
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   =   |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |  TAB  |  !  |  @  |  #   |  $   |  %   |                   | LEFT | DOWN  |  UP   | RIGHT|   `   |       |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp ESC  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH     &kp DOLLAR  &kp PERCENT                    &kp CARET  &kp AMPERSAND  &kp ASTERISK     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL
&kp F1   &kp F2           &kp F3       &kp F4       &kp F5      &kp F6                         &kp F7     &kp F8         &kp F9           &kp F10               &kp F11                &kp F12
&kp TAB  &kp EXCL         &kp AT       &kp HASH     &kp DLLR    &kp PRCNT                      &kp LEFT   &kp DOWN       &kp UP           &kp RIGHT             &kp GRAVE              &trans
&trans   &kp EQUAL        &kp MINUS    &kp PLUS     &kp LBRC    &kp RBRC     &trans    &trans  &kp LBKT   &kp RBKT       &kp SEMI         &kp COLON             &kp BSLH               &trans
                          &trans       &trans       &trans      &trans       &trans    &trans  &trans     &trans         &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            label = "raise";

            // BT select, macOS screenshot/Home/End, paging, clipboard.
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  |ScrSel| Home  |       |      |                | PGUP |      |       |      |  End  |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |      |       |      |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans     &trans   &trans   &trans   &trans        &trans
&trans      &kp INS       &kp LG(LS(N4))  &kp LG(LEFT)  &trans        &trans                        &kp PG_UP  &trans   &trans   &trans   &kp LG(RIGHT)  &trans
&trans      &kp LALT      &kp LCTRL     &kp LSHFT     &trans        &kp CLCK                        &kp PG_DN  &trans   &trans   &trans   &kp DEL       &kp BSPC
&trans      &kp K_UNDO    &kp K_CUT     &kp K_COPY    &kp K_PASTE   &trans        &trans    &trans  &trans     &trans   &trans   &trans   &trans        &trans
                          &trans        &trans        &trans        &trans        &trans    &trans  &trans     &trans   &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            label = "adjust";

            // BT clear/select, ext power toggle, Mission Control / Launchpad / full-screen screenshot.
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | MissCtl | Launchp |ScrFull  |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         |         |        |      |      |       |      |       |       |
            //                    |         |         |         |         |         |        |      |      |       |      |

            bindings = <
&bt BT_CLR         &bt BT_SEL 0                        &bt BT_SEL 1                            &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4    &none  &none  &none  &none  &none  &none
&ext_power EP_TOG  &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS   &kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS  &kp LG(LS(N3))  &none         &none           &none  &none  &none  &none  &none  &none
&none              &none                               &none                                   &none           &none         &none           &none  &none  &none  &none  &none  &none
&none              &none                               &none                                   &none           &none         &none    &none  &none  &none  &none  &none  &none  &none  &none
                                                        &none        &none                      &none           &none         &none    &none  &none  &none  &none  &none
            >;
        };
    };
};
